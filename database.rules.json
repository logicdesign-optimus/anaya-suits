{
  "rules": {
    "family-chat": {
      "messages": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && (!newData.exists() || newData.child('uid').val() === auth.uid)"
        }
      },
      "images": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
